<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.ChessController"
           fx:id="rootStack"
           prefHeight="820.0" prefWidth="1120.0"
           style="-fx-background-color: #1e1e1e;">

    <BorderPane style="-fx-padding: 20;">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 12 0;">
                <Button fx:id="hamburgerButton"
                        text="☰"
                        style="-fx-background-color: #262421;
                               -fx-text-fill: #ffffff;
                               -fx-font-size: 20px;
                               -fx-font-weight: bold;
                               -fx-padding: 6 14 6 14;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;">
                </Button>
                <Label text="Chess"
                       style="-fx-text-fill: #e8e8e8;
                              -fx-font-size: 20px;
                              -fx-font-weight: bold;">
                </Label>
            </HBox>
        </top>

        <center>
            <HBox spacing="24" alignment="CENTER">
                <StackPane minWidth="664" minHeight="664"
                           maxWidth="664" maxHeight="664"
                           style="-fx-background-color: #312e2b;
                                   -fx-background-radius: 10;
                                   -fx-padding: 12;">
                    <GridPane fx:id="boardGrid" alignment="CENTER">
                    </GridPane>
                </StackPane>

                <VBox spacing="14" prefWidth="220">

                    <VBox spacing="6"
                          style="-fx-background-color: #262421;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;">
                        <Label text="BLACK"
                               style="-fx-text-fill: #9a9a9a;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;">
                        </Label>
                        <Label fx:id="blackClockLabel"
                               text="03:00"
                               style="-fx-text-fill: #ffffff;
                                      -fx-font-size: 34px;
                                      -fx-font-weight: bold;">
                        </Label>
                    </VBox>

                    <VBox spacing="6"
                          style="-fx-background-color: #262421;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;">
                        <Label text="WHITE"
                               style="-fx-text-fill: #9a9a9a;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;">
                        </Label>
                        <Label fx:id="whiteClockLabel"
                               text="03:00"
                               style="-fx-text-fill: #ffffff;
                                      -fx-font-size: 34px;
                                      -fx-font-weight: bold;">
                        </Label>
                    </VBox>

                    <VBox spacing="6"
                          style="-fx-background-color: #262421;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;">
                        <Label text="PLAY AS"
                               style="-fx-text-fill: #9a9a9a;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;">
                        </Label>
                        <HBox spacing="6">
                            <Button fx:id="playAsWhiteButton"
                                    text="White"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #3a3a3a;
                                           -fx-text-fill: #ffffff;
                                           -fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-padding: 10;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;">
                            </Button>
                            <Button fx:id="playAsBlackButton"
                                    text="Black"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #3a3a3a;
                                           -fx-text-fill: #ffffff;
                                           -fx-font-size: 13px;
                                           -fx-font-weight: bold;
                                           -fx-padding: 10;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;">
                            </Button>
                        </HBox>
                    </VBox>

                    <Button fx:id="undoButton"
                            text="Undo Last Move"
                            maxWidth="Infinity"
                            style="-fx-background-color: #3a3a3a;
                                   -fx-text-fill: #6a6a6a;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-padding: 12;
                                   -fx-background-radius: 10;">
                    </Button>

                    <VBox spacing="4" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #262421;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;">
                        <Label text="MOVES"
                               style="-fx-text-fill: #9a9a9a;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;">
                        </Label>
                        <ScrollPane fitToWidth="true"
                                    VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent;
                                           -fx-background: transparent;
                                           -fx-border-color: transparent;">
                            <VBox fx:id="movesList" spacing="2"
                                  style="-fx-background-color: transparent;">
                            </VBox>
                        </ScrollPane>
                    </VBox>

                </VBox>
            </HBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 12 0 0 0;">
                <Label fx:id="statusLabel"
                       text="White to move"
                       style="-fx-text-fill: #e8e8e8;">
                    <font>
                        <Font size="16.0"/>
                    </font>
                </Label>
            </HBox>
        </bottom>

    </BorderPane>

</StackPane>